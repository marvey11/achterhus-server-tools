[Unit]
Description=Daily Backup of the Storage Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/achterhus/server-tools.env
ExecStart=/usr/bin/docker compose \
    --project-directory ${PROJECT_DIR} \
    --env-file %h/.config/achterhus/server-tools.env \
    run --rm backup-storage

[Install]
WantedBy=default.target
